<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="GoalKeeperFreekick">
      <ReactiveSequence >
         <!-- <CamTrackBall /> -->
         <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
         <GoToReadyPosition _while="!(ball_location_known || tm_ball_pos_reliable)" />
         <GoToGoalBlockingPosition _while="ball_location_known || tm_ball_pos_reliable" dist_to_goalline="0.25" theta_tolerance="0.2" />
         <SelfLocate mode="trust_direction" _while="odom_calibrated" />
      </ReactiveSequence>
   </BehaviorTree>
</root>
