<!-- 定位模块: 使用多种特征组合进行位置校正 -->

<root BTCPP_format="4" >
  <BehaviorTree ID="Locate">
     <Sequence name="root">
        <SelfLocate mode="trust_direction" />
        <!-- SelfLocateCircle 已实现并注册(全位姿/含朝向校正, 中圈+中线); 默认不挂入级联。
             仿真/回放验证校正量合理后, 取消下一行注释即可灰度启用(置于平移校正器之前, 顺序即优先级)。 -->
        <!-- <SelfLocateCircle msecs_interval="300" max_dist="5.0" max_drift="3.5" max_theta_drift="0.6" /> -->
        <!-- SelfLocatePenalty 尚未实现, 切勿引用(未注册节点会导致 game.xml 加载时 BTCPP 抛异常、启动即崩)。 -->
        <SelfLocate1M msecs_interval="300" max_dist="5.0" max_drift="3.5" />
        <SelfLocate2T msecs_interval="300" max_dist="5.0" max_drift="3.5" />
        <!-- SelfLocatePT 暂注释回休眠(2026-06-19): 几何 bug 已修, 但重新激活后未实机验证。
             注释 = 回到它原本就不生效的状态, 零损失; 验证 /locate/pt/success 合理后取消下一行注释即启用。 -->
        <!-- <SelfLocatePT msecs_interval="300" max_dist="5.0" max_drift="3.5" /> -->
        <SelfLocateLT msecs_interval="300" max_dist="5.0" max_drift="3.5" />
        <SelfLocate2X msecs_interval="300" max_dist="5.0" max_drift="3.5" />
        <!-- SelfLocateBorder 恢复 1.5 保守参数: max_drift 3.5->1.0(防边界误检大跳)、加 validate、降频 800ms -->
        <SelfLocateBorder msecs_interval="800" max_dist="4.0" max_drift="1.0" validate="true"/>
        <!-- SelfLocateLine 迁回 1.5: 已补回置信度/时效/长度三道过滤 + 1.5 保守参数(1500ms, drift<=1.0, validate)。
             ★本批最高风险项: 线易误检。先仿真/回放看 /locate/line/success 合理再信; 不稳就把下一行重新注释即回退。 -->
        <SelfLocateLine msecs_interval="1500" max_dist="5.0" max_drift="1.0" validate="true"/>
     </Sequence>
  </BehaviorTree>
</root>
